# ---------------------------------------------------------------------------
# SASH configuration. Copy to .env and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Ring Partner API (https://developer.amazon.com/docs/ring/) -------------
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_OAUTH_AUTHORIZE_URL=https://account.ring.com/account/integrations/partner-link/authorize
RING_REDIRECT_URI=https://your-host/ring/callback

# --- Local simulator ---------------------------------------------------------
# Point RING_API_BASE_URL at the bundled simulator to run with no credentials:
#   RING_API_BASE_URL=http://127.0.0.1:8791
# The same client code is used against either target.
SASH_SIMULATED=1

# --- Storage -----------------------------------------------------------------
SASH_DB=sash.sqlite

# --- Optional AWS narrative layer (AWS Builder mini-challenge) ---------------
# Leave unset to use the deterministic phrase renderer (the default).
SASH_NARRATIVE_PROVIDER=deterministic
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=
